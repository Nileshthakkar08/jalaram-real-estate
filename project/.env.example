# Public base URL of the website (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Laravel API origin used by server-side rendering (never sent to the browser).
API_INTERNAL_URL=http://127.0.0.1:8000

# Optional shared secret sent with server-side API requests so page rendering is not rate limited.
# Must equal INTERNAL_API_KEY in the API's .env. Generate with: openssl rand -hex 32
API_INTERNAL_KEY=

# Where the dev server proxies /api, /sanctum and /storage. In production Nginx does this instead.
API_PROXY_TARGET=http://127.0.0.1:8000
